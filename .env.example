# Local development defaults
PORT=8080
DATABASE_URL=postgresql://localhost:5432/kahani
STAGING_DATABASE_URL=
LOG_LEVEL=info
NODE_ENV=development

# Local mobile app
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_DOMAIN=localhost:8081
EXPO_PUBLIC_REPL_ID=

# Clerk auth. Leave blank to skip auth in local mobile development.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PROXY_URL=

# Production-only privacy/security settings. Do not use placeholder values in production.
KAHANI_ENCRYPTION_KEY_BASE64=
KAHANI_ENCRYPTION_KEY_ID=primary
KAHANI_PRIVATE_ASSET_STORE=
KAHANI_ALERT_WEBHOOK_URL=
KAHANI_ANALYTICS_WRITE_KEY=
KAHANI_PROVIDER_PHOTO_POLICY=strip_family_photos
KAHANI_ONBOARDING_CONSENT_VERSION=2026-05-19
WORKER_POLL_INTERVAL_MS=1500

# AI story generation. Required for real story generation through the API.
AI_INTEGRATIONS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_MODEL=openai/gpt-5.4-nano
AI_INTEGRATIONS_OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview

# Optional OpenRouter attribution headers. Used only when calling OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Kahani

# Mockup sandbox
MOCKUP_PORT=8081
BASE_PATH=/

# Staging/production hardening placeholders. These are documented in
# docs/staging/secrets-matrix.md and may not all be consumed by local code yet.
NODE_ENV=development
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
PRIVATE_ASSET_STORAGE_PROVIDER=
PRIVATE_ASSET_BUCKET=
PRIVATE_ASSET_REGION=
PRIVATE_ASSET_ACCESS_KEY_ID=
PRIVATE_ASSET_SECRET_ACCESS_KEY=
KMS_PROVIDER=
KMS_KEY_ID=
KMS_REGION=
AWS_ACCOUNT_ID=
SENTRY_BACKEND_DSN=
SENTRY_MOBILE_DSN=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
ANALYTICS_PROVIDER=
ANALYTICS_WRITE_KEY=
ALERT_WEBHOOK_URL=
GENERATION_DAILY_GLOBAL_LIMIT=
GENERATION_DAILY_USER_LIMIT=
GENERATION_MONTHLY_SPEND_LIMIT_USD=
SIGNUP_ENABLED=
GENERATION_ENABLED=
REQUIRED_CONSENT_VERSION=
